{
  "manifest_version": 3,
  "name": "Zephium Focus",
  "short_name": "Focus",
  "version": "1.0.0",
  "description": "Focus rounds that shut chosen sites, and a Time page that shows where the time went. Counted on this device only.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/16.png",
    "32": "assets/icons/32.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  },
  "action": {
    "default_title": "Focus",
    "default_popup": "src/pages/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/16.png",
      "32": "assets/icons/32.png"
    }
  },
  "options_ui": {
    "page": "src/pages/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "alarms", "idle", "notifications", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "start-focus": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Start a focus round"
    },
    "open-time": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Open the Time page"
    }
  }
}
